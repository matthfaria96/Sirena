    "Add Clipboard Contents to Shelf": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar o conteúdo da área de transferência à prateleira"
          }
        }
      }
    },
    "Files and text can also be added from the Services menu of any app (“Adicionar à Prateleira do Sirena”), from the Shortcuts app, or with sirena://shelf-toggle and sirena://shelf-add-clipboard.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos e textos também podem ser adicionados pelo menu Serviços de qualquer app (“Adicionar à Prateleira do Sirena”), pelo app Atalhos ou com sirena://shelf-toggle e sirena://shelf-add-clipboard."
          }
        }
      }
    },
    "Ignored Apps": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
