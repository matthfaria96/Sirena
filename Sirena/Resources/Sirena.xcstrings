        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Ajustes e o painel do app abrem pela Dynamic Island. O ícone volta quando a ilha está desligada ou oculta em tela cheia, ou quando há atualização pronta ou microfone silenciado."
          }
        }
