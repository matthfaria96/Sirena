      }
    },
    "Permission required": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão necessária"
          }
        }
      }
    },
    "Needed to read keys while the switcher is open and to focus, close and quit windows.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessária para ler as teclas com o alternador aberto e para focar, fechar e encerrar janelas."
          }
        }
      }
    },
    "Needed for live window previews. The simple list works without it.": {
      "localizations": {
