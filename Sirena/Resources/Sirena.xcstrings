    "Show at the mouse pointer": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar junto ao ponteiro"
          }
        }
      }
    },
    "The shelf appears next to the pointer when a drag starts.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prateleira aparece ao lado do ponteiro quando um arrasto começa."
          }
        }
      }
    },
    "Show only when dragging to the screen edge": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar só ao arrastar até a borda da tela"
          }
        }
      }
    },
    "The shelf waits until the drag reaches its edge of the screen.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prateleira espera o arrasto chegar à borda dela."
          }
