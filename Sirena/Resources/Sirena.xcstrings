        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixer de som"
          }
        }
      }
    },
    "Volume of the Mac and of each app, the sound output and the microphone, all in one place.": {
      "localizations": {
        "pt-BR": {
