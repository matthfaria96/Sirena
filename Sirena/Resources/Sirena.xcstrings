          }
        }
      }
    },
    "Switch between apps and windows, including minimized windows and multiple windows from the same app.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque de app ou janela, inclusive janelas minimizadas e várias janelas do mesmo app."
          }
