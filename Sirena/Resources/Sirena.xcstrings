    "Apps": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Permission required": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão necessária"
          }
        }
      }
    },
    "Needed to read keys while the switcher is open and to focus, close and quit windows.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessária para ler as teclas com o alternador aberto e para focar, fechar e encerrar janelas."
          }
        }
      }
    },
    "Needed for live window previews. The simple list works without it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessária para os previews ao vivo das janelas. A lista simples funciona sem ela."
          }
        }
      }
    },
    "Window switcher": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternador de janelas"
          }
        }
      }
    },
    "Layout": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout"
          }
        }
      }
    },
    "Window previews": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews das janelas"
          }
        }
      }
    },
    "Large icons": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ícones grandes"
          }
        }
      }
    },
    "Simple list": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista simples"
          }
        }
      }
    },
    "Opens a switcher for the frontmost app’s windows. While the switcher is open, jumps between the selected app’s windows.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um seletor das janelas do app em primeiro plano. Com o seletor aberto, pula entre as janelas do app selecionado."
          }
        }
      }
    },
    "Replace macOS ⌘Tab and ⌘`": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir ⌘Tab e ⌘` do macOS"
          }
        }
      }
    },
    "Disables the matching macOS app and window shortcuts only while the Sirena switcher is active. All running apps stay reachable.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa os atalhos correspondentes de apps e janelas do macOS somente enquanto o alternador do Sirena estiver ativo. Todos os apps abertos continuam acessíveis."
          }
        }
      }
    },
    "Hold %@ to navigate; release to activate the window. Shift or ← goes back; W closes the window; Q quits the app; Esc cancels.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ para navegar; solte para ativar a janela. Shift ou ← volta; W fecha a janela; Q encerra o app; Esc cancela."
          }
        }
      }
    },
    "Appearance delay": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atraso de exibição"
          }
        }
      }
    },
    "How long the shortcut must be held before the switcher appears.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo o atalho precisa ficar pressionado antes de o alternador aparecer."
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático"
          }
        }
      }
    },
    "Maximum columns": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo de colunas"
          }
        }
      }
    },
    "Wraps onto more rows after this many items. Useful on ultrawide displays.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebra para mais linhas depois desse número de itens. Útil em monitores ultrawide."
          }
        }
      }
    },
    "Instant selection": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleção instantânea"
          }
        }
      }
    },
    "Moves the highlight and scroll position immediately as you browse apps and windows.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o destaque e a rolagem imediatamente ao navegar por apps e janelas."
          }
        }
      }
    },
    "S starts a search and pins the switcher open, so typing no longer produces special characters when your shortcut uses ⌥, and a search starting with Q or W no longer closes the window or quits the app by mistake.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "S inicia uma busca e fixa o alternador aberto, assim digitar não produz mais caracteres especiais quando o atalho usa ⌥, e uma busca que comece com Q ou W não fecha a janela nem encerra o app por engano."
          }
        }
      }
    },
    "Show shortcut hints": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar dicas de atalhos"
          }
        }
      }
    },
    "Shows the app and window shortcuts below the icons.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe os atalhos de apps e janelas abaixo dos ícones."
          }
        }
      }
    },
    "Show one entry per app": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma entrada por app"
          }
        }
      }
    },
    "Collapses all of an app’s windows into one entry in the switcher, instead of one entry per window.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junta todas as janelas de um app em uma só entrada no alternador, em vez de uma por janela."
          }
        }
      }
    },
    "Show fullscreen windows": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar janelas em tela cheia"
          }
        }
      }
    },
    "Minimized windows": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas minimizadas"
          }
        }
      }
    },
    "Normal ordering": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordem normal"
          }
        }
      }
    },
    "Place at end": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar no final"
          }
        }
      }
    },
    "Treat hidden apps like minimized windows": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratar apps ocultos como janelas minimizadas"
          }
        }
      }
    },
    "Display with the menu bar": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela com a barra de menus"
          }
        }
      }
    },
    "Display with the active window": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela com a janela ativa"
          }
        }
      }
    },
    "Show on": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar em"
          }
        }
      }
    },
    "Which display the switcher opens on when more than one is connected.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qual tela o alternador abre quando há mais de uma conectada."
          }
        }
      }
    },
    "Show only the current display": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar só a tela atual"
          }
        }
      }
    },
    "Lists only windows on the display under the pointer. If that display has no windows, the switcher does not open.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra apenas as janelas da tela sob o cursor. Se essa tela não tiver janelas, o alternador não abre."
          }
        }
      }
    },
    "Show only the current desktop": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar só a Mesa atual"
          }
        }
