        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld permitidas"
          }
        }
      }
    },
    "From any app.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer app."
          }
        }
      }
    },
    "Moves and resizes windows, pastes from the clipboard history and powers the switcher.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move e redimensiona janelas, cola do histórico e faz o alternador funcionar."
          }
        }
      }
    },
    "Window previews in the Dock and the switcher, and capturing text from the screen.": {
      "localizations": {
        "pt-BR": {
