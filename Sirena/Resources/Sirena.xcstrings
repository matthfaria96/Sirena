            "value": "Ícones Ocultos"
          }
        }
      }
    },
    "Expand beside the arrow": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expandir ao lado da seta"
          }
        }
      }
