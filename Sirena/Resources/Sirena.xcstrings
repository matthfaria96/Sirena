          "stringUnit": {
            "state": "translated",
            "value": "Dock e Alternador"
          }
        }
      }
    },
    "See window previews when hovering the Dock and switch between windows with ⌥ Tab.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja prévias das janelas ao passar o mouse no Dock e alterne entre janelas com ⌥ Tab."
          }
        }
      }
    },
    "Needed to show window thumbnails. Without it, previews show only titles and icons.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessária para mostrar miniaturas das janelas. Sem ela, as prévias mostram só títulos e ícones."
          }
        }
      }
    },
    "Active — allow Screen Recording for thumbnails": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo — permita a Gravação de Tela para ver miniaturas"
          }
        }
      }
    },
