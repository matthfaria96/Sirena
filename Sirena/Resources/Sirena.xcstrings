    "Snap, resize and move windows with shortcuts or by dragging to the screen edges.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixe, redimensione e mova janelas com atalhos ou arrastando até as bordas da tela."
          }
        }
      }
    },
    "Stop your Mac from sleeping or dimming the screen, for as long as you want.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impeça o Mac de repousar ou escurecer a tela pelo tempo que quiser."
          }
        }
      }
    },
    "This feature stops completely after Sirena restarts.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desligar por completo, reinicie o Sirena."
