    "DockDoor": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "DockDoor"
          }
        }
      }
    },
    "DockDoor could not read this folder.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "DockDoor could not read this folder."
          }
        }
      }
    },
    "DockDoor does not record your screen or audio. It only captures static window previews. No information is stored or shared; all processing occurs privately on your device.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DockDoor não grava sua tela ou áudio. Apenas captura pré-visualizações estáticas das janelas."
          }
        }
      }
    },
    "DockDoor Free has no paywall and never will. Pro is a separate app that replaces the macOS Dock entirely for far deeper system control, and buying it is the best way to support the free project.": {
      "comment": "DockDoor Pro banner description",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "DockDoor Free has no paywall and never will. Pro is a separate app that replaces the macOS Dock entirely for far deeper system control, and buying it is the best way to support the free project."
          }
        }
      }
    },
    "DockDoor is open source on GitHub": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "DockDoor is open source on GitHub"
          }
        }
      }
    },
    "DockDoor needs access to your calendars to show events. Please enable Calendar access in System Settings > Privacy & Security > Calendars.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "DockDoor needs access to your calendars to show events. Please enable Calendar access in System Settings > Privacy & Security > Calendars."
          }
        }
      }
    },
    "DockDoor needs permission to access your calendar.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "DockDoor needs permission to access your calendar."
          }
        }
      }
    },
    "DockDoor needs screen recording access. In macOS Sequoia, you'll see this prompt every week or month and after reboots. This is a new system-wide security policy for all screen capture apps.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DockDoor precisa de acesso à gravação de tela. No macOS Sequoia, você verá isso aviso toda semana ou mês após reiniciar. Esta é uma nova política de segurança em todo o sistema para todos os apps de captura de tela."
          }
        }
      }
    },
    "DockDoor Pro": {
      "comment": "DockDoor Pro banner title",
