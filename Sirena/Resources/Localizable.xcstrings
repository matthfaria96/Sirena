    "After Sirena maximizes or almost maximizes a window, executing the same action again moves the window back to its previous size and position.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After Sirena maximizes or almost maximizes a window, executing the same action again moves the window back to its previous size and position."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que o Sirena maximiza (ou quase maximiza) uma janela, repetir a mesma ação devolve a janela ao tamanho e à posição anteriores."
          }
        }
      }
    },
