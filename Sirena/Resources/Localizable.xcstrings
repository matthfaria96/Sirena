    "Tutorial text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nUse the always hidden feature to keep your icons tidy. Here's how to set it\nSteps to enable:\n1. Enable the always hidden “|” (translucent color bar)\n2. Hold  ⌘ and drag it on the left-hand side of the normal bar, then move any icons you want to disappear on the left of that bar.\n3. Finally, please right-click on the collapse “<” icon to make it disappear.\nSteps to view always hidden icons:\n1. You right-click on “<” icon again to view and repeat the action to enable the feature. Enjoy 😉!\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\nUse os ícones sempre ocultos para manter a barra arrumada.\nPara ativar:\n1. Ative a barrinha “|” translúcida\n2. Arraste os ícones (com ⌘) para além dela\n3. Eles ficam sempre escondidos"
          }
        }
      }
    },
